{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster",
  "mainBinaryName": "Aster",
  "version": "1.9.2",
  "identifier": "com.yuseonghyeon.aster",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aster",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 29
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 seonghyeon you",
    "category": "Productivity",
    "shortDescription": "읽기 좋은 Markdown 데스크톱 뷰어",
    "longDescription": "Aster는 Markdown 문서를 편안하게 읽고, 원문을 변경하지 않은 채 개인 메모를 남길 수 있는 데스크톱 뷰어입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5OEM1OUExNDY4NTEyOUEKUldTYUVvVkdvVm1NZWZCS0d2anZXcHJhcFRLUUtnc2VPc05yK29obkZocnJTdC9NYk8xdDJ0eGcK",
      "endpoints": [
        "https://github.com/youseonghyeon/aster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
